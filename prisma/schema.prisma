generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum TaskType {
  TASK
  BUG
  STORY
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(100)
  email           String       @unique @db.VarChar(320)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  role            UserRole     @default(MEMBER)
  tokenVersion    Int          @default(0) @map("token_version")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  teamsCreated    Team[]       @relation("TeamCreator")
  projectsCreated Project[]    @relation("ProjectCreator")
  tasksReported   Task[]       @relation("TaskReporter")
  tasksAssigned   Task[]       @relation("TaskAssignee")
  comments        Comment[]
  activities      Activity[]   @relation("ActivityActor")
  memberships     TeamMember[]

  @@map("users")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  createdById String       @map("created_by") @db.Uuid
  createdBy   User         @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     TeamMember[]
  projects    Project[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("teams")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  teamId      String   @map("team_id") @db.Uuid
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([teamId])
  @@index([createdById])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  taskKey     String       @unique @default(dbgenerated()) @map("task_key") @db.VarChar(32)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  type        TaskType     @default(TASK)
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  projectId   String       @map("project_id") @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?      @map("assignee_id") @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String       @map("reporter_id") @db.Uuid
  reporter    User         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  dueDate     DateTime?    @map("due_date") @db.Date
  labels      String[]     @default([])
  comments    Comment[]
  activities  Activity[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([assigneeId])
  @@index([reporterId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId, createdAt])
  @@index([userId])
  @@map("comments")
}

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("ActivityActor", fields: [userId], references: [id], onDelete: Restrict)
  action    String   @db.VarChar(50)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@index([userId])
  @@map("activities")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}
